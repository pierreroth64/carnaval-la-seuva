---
permalink: "index.html"
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title id="pageTitle">🎪 Carnaval de la Forêt — Le Grand Défilé</title>
  
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Grandstander:ital,wght@0,600;0,800;1,700&family=Patrick+Hand&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            title: ['"Grandstander"', 'cursive', 'sans-serif'],
            body: ['"Fredoka"', 'system-ui', 'sans-serif'],
            hand: ['"Patrick Hand"', 'cursive'],
          },
          colors: {
            moss: { 100: '#E6F3E6', 200: '#CBE5CC', 500: '#529E57', 700: '#2F6B34', 900: '#1B431F' },
            bark: { 500: '#68452B', 700: '#422B1B', 900: '#2B1A0F' },
            mushroom: { 400: '#FF6B6B', 500: '#E63946', 600: '#C52233' },
            firefly: '#FFD152',
            foliage: '#122D16',
            festive: { orange: '#FF8A3D', berry: '#C2387B', gold: '#F4B41A', teal: '#20A39E' }
          },
          boxShadow: {
            'wobble': '0 12px 25px -4px rgba(27, 67, 31, 0.25), 0 6px 10px -2px rgba(66, 43, 27, 0.15)',
            'wobble-hover': '0 24px 35px -8px rgba(230, 57, 70, 0.35), 0 10px 20px -3px rgba(32, 163, 158, 0.25)',
            'wooden': 'inset 0 4px 0 rgba(255,255,255,0.25), 0 6px 0 #2B1A0F, 0 10px 18px rgba(0,0,0,0.3)',
          }
        }
      }
    }
  </script>

  <style>
    .forest-bg {
      background-color: #0f2712;
      background-image: 
        radial-gradient(circle at 15% 20%, rgba(82, 158, 87, 0.2) 0%, transparent 40%),
        radial-gradient(circle at 85% 75%, rgba(244, 180, 26, 0.15) 0%, transparent 45%),
        radial-gradient(circle at 50% 50%, rgba(32, 163, 158, 0.12) 0%, transparent 50%),
        radial-gradient(#18441c 2px, transparent 2px);
      background-size: 100% 100%, 100% 100%, 100% 100%, 32px 32px;
    }
    .bunting-triangle {
      width: 0; height: 0;
      border-left: 18px solid transparent;
      border-right: 18px solid transparent;
      border-top: 26px solid;
      filter: drop-shadow(0 3px 2px rgba(0,0,0,0.25));
      animation: flagWiggle 2.8s ease-in-out infinite alternate;
      transform-origin: top center;
    }
    @keyframes flagWiggle { 0% { transform: rotate(-6deg); } 100% { transform: rotate(6deg); } }
    .leaning-drawing {
      transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.35s ease;
      will-change: transform;
    }
    @media (hover: hover) {
      .leaning-drawing:hover {
        transform: scale(1.05) rotate(0deg) translateY(-8px) !important;
        z-index: 20;
      }
    }
    .sketch-border { border: 4px solid #2B1A0F; border-radius: 24px; }
    .markdown-body h1, .markdown-body h2, .markdown-body h3 {
      font-family: 'Grandstander', cursive;
      color: #1B431F;
      font-weight: 800;
      margin-top: 1.25rem;
      margin-bottom: 0.5rem;
    }
    .markdown-body h1 { font-size: 1.75rem; color: #C52233; }
    .markdown-body h2 { font-size: 1.4rem; color: #2F6B34; }
    .markdown-body h3 { font-size: 1.2rem; color: #FF8A3D; }
    .markdown-body p { margin-bottom: 0.9rem; line-height: 1.7; font-size: 1.05rem; color: #382c24; }
    .markdown-body strong { color: #9f1e29; }
    .markdown-body blockquote {
      border-left: 5px solid #FFD152;
      background: #FFF8E7;
      padding: 0.75rem 1.2rem;
      border-radius: 0 16px 16px 0;
      font-family: 'Patrick Hand', cursive;
      font-size: 1.3rem;
      color: #5C3E14;
      margin: 1.25rem 0;
    }
    .markdown-body ul, .markdown-body ol { margin-left: 1.4rem; margin-bottom: 1rem; list-style-type: '🌰 '; }
    .markdown-body li { margin-bottom: 0.35rem; }
    .markdown-body code {
      background: #E8F5E9;
      color: #1B431F;
      padding: 0.2rem 0.5rem;
      border-radius: 8px;
      font-weight: 600;
      font-size: 0.85em;
    }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>
</head>
<body class="forest-bg text-neutral-100 min-h-screen flex flex-col font-body selection:bg-firefly selection:text-bark-900 overflow-x-hidden">

  <!-- Guirlande festive -->
  <div class="w-full flex justify-center overflow-hidden h-6 gap-2 sm:gap-6 pt-0 select-none pointer-events-none opacity-90">
    <div class="bunting-triangle border-t-mushroom-500"></div>
    <div class="bunting-triangle border-t-firefly"></div>
    <div class="bunting-triangle border-t-festive-teal"></div>
    <div class="bunting-triangle border-t-festive-orange"></div>
    <div class="bunting-triangle border-t-festive-berry"></div>
    <div class="bunting-triangle border-t-moss-500"></div>
  </div>

  <!-- Header -->
  <header class="w-full max-w-6xl mx-auto px-4 py-3 sm:py-4 flex flex-wrap items-center justify-between gap-3 z-30">
    <div class="flex items-center gap-3 cursor-pointer group" onclick="navigateHome()">
      <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-firefly text-bark-900 flex items-center justify-center text-2xl sm:text-3xl shadow-wooden group-hover:rotate-12 transition-transform">
        🦡
      </div>
      <div>
        <h1 id="headerTitle" class="text-xl sm:text-3xl md:text-4xl font-title font-extrabold tracking-tight text-white drop-shadow flex items-center gap-2">
          Carnaval de la Forêt <span class="text-xl sm:text-2xl animate-bounce">🎉</span>
        </h1>
        <p id="headerSubtitle" class="text-xs sm:text-sm text-moss-200 font-hand text-base sm:text-lg">
          Costumes loufoques &amp; créatures déchaînées!
        </p>
      </div>
    </div>

    <!-- Actions & Langues -->
    <div class="flex items-center gap-2">
      <!-- Sélecteur de langue Global FR / OC -->
      <div class="bg-foliage/90 p-1 rounded-2xl border border-white/20 flex items-center shadow-wooden">
        <button id="langFrBtn" onclick="setLanguage('fr')" class="px-2.5 py-1 rounded-xl text-xs font-title font-extrabold bg-firefly text-bark-900 shadow transition">
          FR 🇫🇷
        </button>
        <button id="langOcBtn" onclick="setLanguage('oc')" class="px-2.5 py-1 rounded-xl text-xs font-title font-extrabold text-moss-200 hover:text-white transition">
          OC 🌰
        </button>
      </div>

      <!-- Confettis -->
      <button onclick="launchForestConfetti()" class="px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-2xl bg-festive-orange hover:bg-orange-400 text-white font-title font-bold text-xs sm:text-sm shadow-wooden active:scale-95 transition flex items-center gap-1.5">
        <i class="fa-solid fa-wand-magic-sparkles text-firefly"></i>
        <span class="hidden sm:inline" id="confettiBtnLabel">Confettis!</span>
      </button>
    </div>
  </header>

  <!-- Catégories -->
  <div class="max-w-6xl w-full mx-auto px-4 mt-2 flex items-center justify-between gap-3 text-sm">
    <div class="flex items-center gap-2 overflow-x-auto no-scrollbar py-1 max-w-full">
      <span id="filterLabel" class="text-xs text-moss-200 font-bold uppercase tracking-wider whitespace-nowrap mr-1">Troupes :</span>
      <button onclick="filterCategory('all')" class="cat-pill active px-3 py-1 rounded-full text-xs font-bold whitespace-nowrap transition border border-white/20 bg-firefly text-bark-900 shadow" id="catAll">Tous</button>
      <button onclick="filterCategory('Costume')" class="cat-pill px-3 py-1 rounded-full text-xs font-bold whitespace-nowrap transition border border-white/20 bg-foliage/80 text-white hover:bg-moss-500" id="catCostume">🎭 Costumes</button>
      <button onclick="filterCategory('Char')" class="cat-pill px-3 py-1 rounded-full text-xs font-bold whitespace-nowrap transition border border-white/20 bg-foliage/80 text-white hover:bg-moss-500" id="catChar">🚜 Chars</button>
      <button onclick="filterCategory('Fanfare')" class="cat-pill px-3 py-1 rounded-full text-xs font-bold whitespace-nowrap transition border border-white/20 bg-foliage/80 text-white hover:bg-moss-500" id="catFanfare">🎺 Fanfares</button>
    </div>
  </div>

  <!-- Contenu Principal -->
  <main class="flex-grow max-w-6xl w-full mx-auto px-4 py-6">
    <!-- Galerie -->
    <section id="galleryView">
      <div class="text-center max-w-2xl mx-auto mb-6 sm:mb-8">
        <h2 id="galleryTitle" class="text-2xl sm:text-4xl font-title font-black text-firefly drop-shadow-md">
          Les Vignettes Déjantées du Grand Défilé
        </h2>
        <p id="gallerySubtitle" class="text-moss-100 text-xs sm:text-sm mt-1 sm:mt-2 font-body">
          Cliquez sur un dessin penché pour lire son histoire secrète !
        </p>
      </div>

      <div id="drawingsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-10 pt-2 pb-12">
        <!-- Rendu via JS depuis les données 11ty compilées -->
      </div>
    </section>

    <!-- Vue Détail -->
    <section id="detailView" class="hidden max-w-3xl mx-auto">
      <div class="mb-4 flex items-center justify-between">
        <button onclick="navigateHome()" class="px-4 py-2 rounded-2xl bg-firefly text-bark-900 font-title font-extrabold shadow-wooden hover:bg-yellow-300 active:scale-95 transition flex items-center gap-2 text-xs sm:text-sm">
          <i class="fa-solid fa-arrow-left"></i>
          <span id="backBtnLabel">Retour au Défilé</span>
        </button>

        <!-- Sélecteur FR / OC dans la fiche -->
        <div class="bg-[#FFFDF7] p-1 rounded-2xl border-2 border-bark-700 flex items-center shadow-md">
          <button id="detailFrBtn" onclick="setLanguage('fr')" class="px-2.5 py-0.5 rounded-xl text-xs font-title font-extrabold bg-mushroom-500 text-white transition">FR</button>
          <button id="detailOcBtn" onclick="setLanguage('oc')" class="px-2.5 py-0.5 rounded-xl text-xs font-title font-extrabold text-bark-900 hover:text-mushroom-500 transition">OC</button>
        </div>
      </div>

      <article class="bg-[#FFFDF7] text-neutral-900 sketch-border p-5 sm:p-10 shadow-wobble-hover relative overflow-hidden rounded-3xl" id="detailCardArticle">
        <div class="relative w-full aspect-[4/3] rounded-2xl overflow-hidden bg-moss-100 border-4 border-bark-700 shadow-inner mb-5 flex items-center justify-center">
          <img id="detailImage" src="" alt="Vignette" class="w-full h-full object-cover">
          <span id="detailBadge" class="absolute top-3 right-3 text-xs font-title font-bold px-3 py-1 rounded-full bg-mushroom-500 text-white shadow-md uppercase"></span>
        </div>

        <div class="border-b-4 border-dashed border-moss-200 pb-4 mb-5">
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
            <h2 id="detailTitle" class="text-2xl sm:text-4xl font-title font-extrabold text-bark-900"></h2>
            <span id="detailTroupe" class="text-base sm:text-xl font-hand text-festive-berry font-bold"></span>
          </div>
          <div class="flex flex-wrap items-center gap-2 sm:gap-3 mt-2 text-xs font-bold text-moss-700">
            <span id="detailAccessoire" class="bg-moss-100 px-3 py-1 rounded-full"></span>
            <span id="detailCri" class="bg-orange-100 text-orange-900 px-3 py-1 rounded-full"></span>
          </div>
        </div>

        <div id="detailMarkdown" class="markdown-body"></div>

        <div class="mt-8 pt-5 border-t-2 border-moss-200 flex justify-between items-center text-xs sm:text-sm font-title font-bold">
          <button onclick="navigateArtwork(-1)" class="px-3.5 py-2 rounded-xl bg-moss-100 hover:bg-moss-200 text-moss-900 flex items-center gap-1.5 transition">
            <i class="fa-solid fa-chevron-left text-xs"></i> <span id="prevBtnLabel">Précédent</span>
          </button>
          <span class="font-hand text-lg sm:text-2xl text-festive-orange hidden sm:inline">🌲 Danse sous les sapins ! 🌲</span>
          <button onclick="navigateArtwork(1)" class="px-3.5 py-2 rounded-xl bg-moss-100 hover:bg-moss-200 text-moss-900 flex items-center gap-1.5 transition">
            <span id="nextBtnLabel">Suivant</span> <i class="fa-solid fa-chevron-right text-xs"></i>
          </button>
        </div>
      </article>
    </section>
  </main>

  <footer class="mt-auto border-t-2 border-white/10 bg-foliage/90 py-5 text-center text-xs text-moss-200">
    <p class="font-hand text-lg sm:text-xl text-firefly" id="footerQuote">🎪 "Aucun blaireau n'a été blessé durant les lancers de confettis." 🎪</p>
    <p class="mt-1 opacity-70">Carnaval de la Forêt Enchantée • 100% Statique (Markdown + Eleventy)</p>
  </footer>

  <!-- DONNÉES INJECTÉES PAR ELEVENTY DEPUIS LES FICHIERS MARKDOWN -->
  <script>
    const CARNAVAL_DATA = [
      {% for item in collections.vignettes %}
      {
        id: {{ item.data.id | dump | safe }},
        order: {{ item.data.order }},
        tilt: {{ item.data.tilt | dump | safe }},
        image: {{ item.data.image | dump | safe }},
        fr: {
          title: {{ item.data.fr.title | dump | safe }},
          category: {{ item.data.fr.category | dump | safe }},
          troupe: {{ item.data.fr.troupe | dump | safe }},
          accessoire: {{ item.data.fr.accessoire | dump | safe }},
          cri: {{ item.data.fr.cri | dump | safe }},
          description: {{ item.templateContent | dump | safe }}
        },
        oc: {
          title: {{ item.data.oc.title | dump | safe }},
          category: {{ item.data.oc.category | dump | safe }},
          troupe: {{ item.data.oc.troupe | dump | safe }},
          accessoire: {{ item.data.oc.accessoire | dump | safe }},
          cri: {{ item.data.oc.cri | dump | safe }},
          description: {{ item.data.oc.description | dump | safe }}
        }
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ];

    const UI_I18N = {
      fr: {
        pageTitle: "🎪 Carnaval de la Forêt — Le Grand Défilé",
        headerTitle: "Carnaval de la Forêt",
        headerSubtitle: "Costumes loufoques & créatures déchaînées !",
        galleryTitle: "Les Vignettes Déjantées du Grand Défilé",
        gallerySubtitle: "Cliquez sur un dessin penché pour lire son histoire secrète !",
        filterLabel: "Troupes :",
        catAll: "Tous",
        catCostume: "🎭 Costumes",
        catChar: "🚜 Chars",
        catFanfare: "🎺 Fanfares",
        discoverBtn: "Découvrir l'histoire 📜",
        backBtn: "Retour au Défilé",
        prevBtn: "Précédent",
        nextBtn: "Suivant",
        confettiLabel: "Confettis !",
        footerQuote: "🎪 \"Aucun blaireau n'a été blessé durant les lancers de confettis.\" 🎪",
        troupePrefix: "Troupe : ",
        criPrefix: "Cri : ",
        emptyFilter: "Aucun participant trouvé pour cette troupe !"
      },
      oc: {
        pageTitle: "🎪 Carnaval de la Selva — La Granda Parada",
        headerTitle: "Carnaval de la Selva",
        headerSubtitle: "Costums esboirats & bèstias endiabladas !",
        galleryTitle: "Las Vinhetas Esboiradas de la Granda Parada",
        gallerySubtitle: "Clicatz sus un dessenh clinat per legir son istòria secreta !",
        filterLabel: "Tropas :",
        catAll: "Totes",
        catCostume: "🎭 Costums",
        catChar: "🚜 Carris",
        catFanfare: "🎺 Fanfaras",
        discoverBtn: "Descobrir l'istòria 📜",
        backBtn: "Tornar a la Parada",
        prevBtn: "Precedent",
        nextBtn: "Seguent",
        confettiLabel: "Confetis !",
        footerQuote: "🎪 \"Cap de taisson foguèt pas ferit durant los getons de confetis.\" 🎪",
        troupePrefix: "Tropa : ",
        criPrefix: "Crit : ",
        emptyFilter: "Cap de participant trobat per aquesta tropa !"
      }
    };

    let currentLang = 'fr';
    let currentFilter = 'all';
    let currentArtworkIndex = 0;

    function setLanguage(lang) {
      currentLang = lang;
      
      // Mettre à jour les boutons d'en-tête
      const frBtn = document.getElementById('langFrBtn');
      const ocBtn = document.getElementById('langOcBtn');
      if (lang === 'fr') {
        frBtn.className = "px-2.5 py-1 rounded-xl text-xs font-title font-extrabold bg-firefly text-bark-900 shadow transition";
        ocBtn.className = "px-2.5 py-1 rounded-xl text-xs font-title font-extrabold text-moss-200 hover:text-white transition";
      } else {
        ocBtn.className = "px-2.5 py-1 rounded-xl text-xs font-title font-extrabold bg-firefly text-bark-900 shadow transition";
        frBtn.className = "px-2.5 py-1 rounded-xl text-xs font-title font-extrabold text-moss-200 hover:text-white transition";
      }

      // Mettre à jour les boutons de fiche détail
      const detailFr = document.getElementById('detailFrBtn');
      const detailOc = document.getElementById('detailOcBtn');
      if (detailFr && detailOc) {
        if (lang === 'fr') {
          detailFr.className = "px-2.5 py-0.5 rounded-xl text-xs font-title font-extrabold bg-mushroom-500 text-white transition";
          detailOc.className = "px-2.5 py-0.5 rounded-xl text-xs font-title font-extrabold text-bark-900 hover:text-mushroom-500 transition";
        } else {
          detailOc.className = "px-2.5 py-0.5 rounded-xl text-xs font-title font-extrabold bg-mushroom-500 text-white transition";
          detailFr.className = "px-2.5 py-0.5 rounded-xl text-xs font-title font-extrabold text-bark-900 hover:text-mushroom-500 transition";
        }
      }

      const t = UI_I18N[lang];
      document.getElementById('pageTitle').textContent = t.pageTitle;
      document.getElementById('headerTitle').childNodes[0].nodeValue = t.headerTitle + ' ';
      document.getElementById('headerSubtitle').textContent = t.headerSubtitle;
      document.getElementById('galleryTitle').textContent = t.galleryTitle;
      document.getElementById('gallerySubtitle').textContent = t.gallerySubtitle;
      document.getElementById('filterLabel').textContent = t.filterLabel;
      document.getElementById('catAll').textContent = t.catAll;
      document.getElementById('catCostume').textContent = t.catCostume;
      document.getElementById('catChar').textContent = t.catChar;
      document.getElementById('catFanfare').textContent = t.catFanfare;
      document.getElementById('backBtnLabel').textContent = t.backBtn;
      document.getElementById('prevBtnLabel').textContent = t.prevBtn;
      document.getElementById('nextBtnLabel').textContent = t.nextBtn;
      document.getElementById('confettiBtnLabel').textContent = t.confettiLabel;
      document.getElementById('footerQuote').textContent = t.footerQuote;

      renderGallery();

      // Si la vue détail est affichée, rafraîchir
      if (!document.getElementById('detailView').classList.contains('hidden')) {
        openArtwork(CARNAVAL_DATA[currentArtworkIndex].id, false);
      }
    }

    function renderGallery() {
      const grid = document.getElementById('drawingsGrid');
      grid.innerHTML = '';
      const t = UI_I18N[currentLang];

      const filtered = currentFilter === 'all'
        ? CARNAVAL_DATA
        : CARNAVAL_DATA.filter(item => item.fr.category.toLowerCase() === currentFilter.toLowerCase());

      if (filtered.length === 0) {
        grid.innerHTML = `
          <div class="col-span-full py-16 text-center text-moss-200">
            <span class="text-5xl block mb-3">🍃</span>
            <p class="font-title text-xl">${t.emptyFilter}</p>
          </div>
        `;
        return;
      }

      filtered.forEach((art, index) => {
        const itemData = art[currentLang];
        const tilt = window.innerWidth < 640 ? '0deg' : (art.tilt || '0deg');

        const card = document.createElement('div');
        card.className = 'leaning-drawing group cursor-pointer bg-[#FFFDF7] text-neutral-900 sketch-border p-4 shadow-wobble hover:shadow-wobble-hover flex flex-col justify-between rounded-3xl relative';
        card.style.transform = `rotate(${tilt})`;

        card.onclick = () => {
          launchForestConfetti();
          openArtwork(art.id);
        };

        let badgeColor = 'bg-mushroom-500';
        if (art.fr.category === 'Char') badgeColor = 'bg-festive-orange';
        if (art.fr.category === 'Fanfare') badgeColor = 'bg-festive-teal';

        card.innerHTML = `
          <div>
            <div class="relative w-full aspect-[4/3] rounded-2xl overflow-hidden bg-moss-100 border-2 border-bark-900 mb-3 shadow-inner">
              <img src="${art.image}" alt="${itemData.title}" loading="lazy" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105">
              <span class="absolute top-2.5 right-2.5 text-[11px] font-title font-extrabold px-3 py-1 rounded-full ${badgeColor} text-white shadow-md">
                ${itemData.category}
              </span>
              <span class="absolute bottom-2 left-2 bg-bark-900/85 text-firefly text-[11px] px-2 py-0.5 rounded-lg font-hand font-bold">
                📢 ${itemData.cri}
              </span>
            </div>
            <h3 class="font-title text-lg sm:text-xl font-black text-bark-900 group-hover:text-mushroom-600 transition-colors">
              ${itemData.title}
            </h3>
            <p class="text-xs font-hand text-base sm:text-lg text-moss-700 mt-0.5">
              ${itemData.troupe}
            </p>
          </div>
          <div class="mt-4 pt-3 border-t-2 border-dashed border-moss-200 flex items-center justify-between text-xs font-title font-bold text-festive-orange">
            <span>${t.discoverBtn}</span>
            <span class="w-6 h-6 rounded-full bg-firefly text-bark-900 flex items-center justify-center group-hover:translate-x-1 transition-transform">
              <i class="fa-solid fa-arrow-right text-[10px]"></i>
            </span>
          </div>
        `;
        grid.appendChild(card);
      });
    }

    function filterCategory(cat) {
      currentFilter = cat;
      document.querySelectorAll('.cat-pill').forEach(btn => {
        btn.classList.remove('active', 'bg-firefly', 'text-bark-900');
        btn.classList.add('bg-foliage/80', 'text-white');
      });
      event.currentTarget.classList.add('active', 'bg-firefly', 'text-bark-900');
      event.currentTarget.classList.remove('bg-foliage/80', 'text-white');
      renderGallery();
    }

    function openArtwork(id, doScroll = true) {
      const index = CARNAVAL_DATA.findIndex(a => a.id === id);
      if (index === -1) return;
      currentArtworkIndex = index;
      const art = CARNAVAL_DATA[index];
      const data = art[currentLang];
      const t = UI_I18N[currentLang];

      window.location.hash = `vignette/${art.id}`;

      document.getElementById('detailImage').src = art.image;
      document.getElementById('detailTitle').textContent = data.title;
      document.getElementById('detailTroupe').textContent = `${t.troupePrefix} ${data.troupe}`;
      document.getElementById('detailBadge').textContent = data.category;
      document.getElementById('detailAccessoire').innerHTML = `<i class="fa-solid fa-hat-cowboy mr-1 text-festive-orange"></i> ${data.accessoire}`;
      document.getElementById('detailCri').innerHTML = `<i class="fa-solid fa-bullhorn mr-1 text-mushroom-500"></i> ${t.criPrefix} ${data.cri}`;

      const detailMd = document.getElementById('detailMarkdown');
      if (currentLang === 'fr') {
        detailMd.innerHTML = data.description;
      } else {
        detailMd.innerHTML = window.marked ? marked.parse(data.description.trim()) : data.description;
      }

      document.getElementById('galleryView').classList.add('hidden');
      document.getElementById('detailView').classList.remove('hidden');

      if (doScroll) window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function navigateHome() {
      history.pushState("", document.title, window.location.pathname + window.location.search);
      document.getElementById('detailView').classList.add('hidden');
      document.getElementById('galleryView').classList.remove('hidden');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function navigateArtwork(dir) {
      currentArtworkIndex = (currentArtworkIndex + dir + CARNAVAL_DATA.length) % CARNAVAL_DATA.length;
      openArtwork(CARNAVAL_DATA[currentArtworkIndex].id);
    }

    function launchForestConfetti() {
      if (typeof confetti === 'function') {
        confetti({
          particleCount: 60,
          spread: 70,
          origin: { y: 0.65 },
          colors: ['#E63946', '#FFD152', '#20A39E', '#529E57', '#FF8A3D']
        });
      }
    }

    window.addEventListener('popstate', () => {
      const hash = window.location.hash;
      if (hash.startsWith('#vignette/')) {
        openArtwork(hash.replace('#vignette/', ''), false);
      } else {
        navigateHome();
      }
    });

    window.onload = function() {
      setLanguage('fr');
      if (window.location.hash.startsWith('#vignette/')) {
        openArtwork(window.location.hash.replace('#vignette/', ''));
      }
    };
  </script>
</body>
</html>
