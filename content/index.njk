  </footer>

  <script>
    const EDITO_DATA = {
      fr: {
        badge: "Le journal du bois",
        title: "🌿 Il revient !",
        excerpt: "Incroyable... 🔥 ... Nous avons reçu un message de la plus haute importance ! 🚨 Une lettre manuscrite que nous publions ici...",
        full_markdown: `
    ### Une lettre à l'attention des Lasseuboises et des Lasseubois postée par un messager inconnu !

<div class="max-w-2xl mx-auto p-8 sm:p-12 my-6 rounded-sm text-[#382618] shadow-xl -rotate-1 border border-amber-900/20 bg-[#f8f1e0] bg-[radial-gradient(ellipse_at_center,_rgba(255,251,240,0.95)_40%,_rgba(225,198,154,0.4)_85%,_rgba(190,154,103,0.6)_100%)] [box-shadow:inset_0_0_35px_rgba(165,125,75,0.35),0_10px_25px_-5px_rgba(0,0,0,0.3)]">
<div class="whitespace-pre-line font-playwrite-in text-xl text-black">

Adishatz La Seuva !

Je quitte les contrées Aragonaises en début d'année pour rejoindre le Béarn.
Il paraît qu'à Lasseube, ce pays de brigands, je pourrais prendre du bon temps.
Engraissez bien vos cochons et préparez vos _"chinchons"_ car j'aime à faire ripaille !
Entouré de ma garde rapprochée je pourrais arriver par Vic de baigt ou peut être par Lembeye de Haut.
Je ferai certainement une pause à Côte blanche avant d'investir le village et d'encanailler la population.
Si je franchis les Pyrénées sans embuches, je serais certainement aux portes de votre village le samedi 30 janvier en fin d'après midi.

Tenez vous prêts et d'ici là, portez vous bien.

Sent Pançard    
</div>
</div>
        `
      },
      oc: {
        badge: "Lo jornau deu bosc",
        title: "🌿 Que torna !",
        excerpt: "De non pas pensar... 🔥... Qu'avem recebut un messatge de la mei hauta importança ! 🚨 Ua letra escrivuda a la man qui publicam ací...",
        full_markdown: `
    ### Ua letra a l'atencion de las Seuvetonas e deus Seuvetons postada per un messatgèr inconegut

<div class="max-w-2xl mx-auto p-8 sm:p-12 my-6 rounded-sm text-[#382618] shadow-xl -rotate-1 border border-amber-900/20 bg-[#f8f1e0] bg-[radial-gradient(ellipse_at_center,_rgba(255,251,240,0.95)_40%,_rgba(225,198,154,0.4)_85%,_rgba(190,154,103,0.6)_100%)] [box-shadow:inset_0_0_35px_rgba(165,125,75,0.35),0_10px_25px_-5px_rgba(0,0,0,0.3)]">
<div class="whitespace-pre-line font-playwrite-in text-xl text-black">

Adishatz La Seuva !

Que quiti las contradas Aragonesas en debuta d'annada entà tornar en Biarn.
Que's pareish qu'a La Seuva, pais de brigans, que poderí préner un drin de bon temps.
Engreishatz plan los vòstes pòrcs e preparatz los chinchons per'mor qu'aimi hartar !
Dab la mia guarda personau, que poderí arribar per Vic de Baigt o dilhèu Lembeja de Haut.
Que harèi ua pausa de cap a Còsta Blanca abanç de destimborlar lo vilatge e encanalhar la populacion.
Si trauqui los Pireneus shens chepics, que serèi a l'entrada de La Seuva lo dissabte 30 de genèr en fin de vrèspe..

Tienetz-vse prèsts e portatz-vse plan !

Sent Pançard        
</div>
</div>
    `
      }
    };

    const CARNAVAL_DATA = [
      {% for item in collections.vignettes %}
      {
        id: {{ item.data.id | dump | safe }},
        order: {{ item.data.order }},
        tilt: {{ item.data.tilt | dump | safe }},
        image: {{ item.data.image | dump | safe }},
        fr: {
          title: {{ item.data.fr.title | dump | safe }},
          subtitle: {{ (item.data.fr.subtitle or "") | dump | safe }},
          category: {{ item.data.fr.category | dump | safe }},
          accessoire: {{ item.data.fr.accessoire | dump | safe }},
          cri: {{ item.data.fr.cri | dump | safe }},
          description: {{ item.templateContent | dump | safe }}
        },
        oc: {
          title: {{ item.data.oc.title | dump | safe }},
          subtitle: {{ (item.data.oc.subtitle or "") | dump | safe }},
          category: {{ item.data.oc.category | dump | safe }},
          accessoire: {{ item.data.oc.accessoire | dump | safe }},
          cri: {{ item.data.oc.cri | dump | safe }},
          description: {{ item.data.oc.description | dump | safe }}
        }
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ];

    const UI_I18N = {
      fr: {
        pageTitle: "🎪 Carnaval Biarnés de Lasseube",
        headerTitle: "Carnaval Biarnés de La Seuva",
        headerSubtitle: "30 janvier 2027",
        galleryTitle: "Découvrez l'univers du Carnaval Béarnais de Lasseube !",
        filterLabel: "Catégories :",
        catAll: "Tous",
        catPersonnages: "🎭 Personnages",
        catHistoire: "📜 Histoire",
        catFaireCarnaval: "🎉 Faire Carnaval",
        catInfosPratiques: "ℹ️ Infos pratiques",
        discoverBtn: "Découvrir 📜",
        backBtn: "Retour",
        prevBtn: "Précédent",
        nextBtn: "Suivant",
        confettiLabel: "Confettis !",
        footerQuote: "🌳 \"A La Seuva qu'avem coratge\" 🌿",
        criPrefix: "",
        emptyFilter: "Aucune vignette trouvée pour cette catégorie !",
        editoMore: "En savoir plus",
        editoLess: "Réduire la lecture"
      },
      oc: {
        pageTitle: "🎪 Carnaval Biarnés de La Seuva",
        headerTitle: "Carnaval Biarnés de La Seuva",
        headerSubtitle: "30 de genèr 2027",
        galleryTitle: "Descobritz l'univèrs deu Carnaval Biarnés de La Seuva !",
        filterLabel: "Categorias :",
        catAll: "Totas",
        catPersonnages: "🎭 Personatges",
        catHistoire: "📜 Istòria",
        catFaireCarnaval: "🎉 Har Carnaval",
        catInfosPratiques: "ℹ️ Infòs practicas",
        discoverBtn: "Descobrir 📜",
        backBtn: "Tornar",
        prevBtn: "Precedent",
        nextBtn: "Seguent",
        confettiLabel: "Confetis !",
        footerQuote: "🌳 \"A La Seuva qu'avem coratge\" 🌿",
        criPrefix: "",
        emptyFilter: "Nada vinheta trobada per aquesta categoria !",
        editoMore: "Ne saber mai",
        editoLess: "Redusir la lectura"
      }
    };

    let currentLang = 'fr';
    let currentFilter = 'all';
    let currentArtworkIndex = 0;
    let isEditoOpen = false;

    function toggleEdito() {
      isEditoOpen = !isEditoOpen;
      const content = document.getElementById('editoExpandedContent');
      const text = document.getElementById('editoToggleText');
      const icon = document.getElementById('editoToggleIcon');
      const t = UI_I18N[currentLang];

      if (isEditoOpen) {
        content.classList.remove('hidden');
        text.textContent = t.editoLess;
        icon.classList.add('rotate-180');
      } else {
        content.classList.add('hidden');
        text.textContent = t.editoMore;
        icon.classList.remove('rotate-180');
      }
    }

    function updateEdito() {
      const edito = EDITO_DATA[currentLang];
      const t = UI_I18N[currentLang];
      
      document.getElementById('editoBadge').textContent = edito.badge;
      document.getElementById('editoTitle').textContent = edito.title;
      document.getElementById('editoExcerpt').textContent = edito.excerpt;
      
      const editoContent = document.getElementById('editoExpandedContent');
      editoContent.innerHTML = window.marked ? marked.parse(edito.full_markdown.trim()) : edito.full_markdown;

      document.getElementById('editoToggleText').textContent = isEditoOpen ? t.editoLess : t.editoMore;
    }

    function setLanguage(lang) {
      currentLang = lang;
      
      const frBtn = document.getElementById('langFrBtn');
      const ocBtn = document.getElementById('langOcBtn');
      if (lang === 'fr') {
        frBtn.className = "px-2.5 py-1 rounded-xl text-xs font-title font-extrabold bg-firefly text-bark-900 shadow transition flex items-center gap-1.5";
        ocBtn.className = "px-2.5 py-1 rounded-xl text-xs font-title font-extrabold text-moss-200 hover:text-white transition flex items-center gap-1.5";
      } else {
        ocBtn.className = "px-2.5 py-1 rounded-xl text-xs font-title font-extrabold bg-firefly text-bark-900 shadow transition flex items-center gap-1.5";
        frBtn.className = "px-2.5 py-1 rounded-xl text-xs font-title font-extrabold text-moss-200 hover:text-white transition flex items-center gap-1.5";
      }

      const detailFr = document.getElementById('detailFrBtn');
      const detailOc = document.getElementById('detailOcBtn');
      if (detailFr && detailOc) {
        if (lang === 'fr') {
          detailFr.className = "px-2.5 py-0.5 rounded-xl text-xs font-title font-extrabold bg-mushroom-500 text-white transition flex items-center gap-1";
          detailOc.className = "px-2.5 py-0.5 rounded-xl text-xs font-title font-extrabold text-bark-900 hover:text-mushroom-500 transition flex items-center gap-1";
        } else {
          detailOc.className = "px-2.5 py-0.5 rounded-xl text-xs font-title font-extrabold bg-mushroom-500 text-white transition flex items-center gap-1";
          detailFr.className = "px-2.5 py-0.5 rounded-xl text-xs font-title font-extrabold text-bark-900 hover:text-mushroom-500 transition flex items-center gap-1";
        }
      }

      const t = UI_I18N[lang];
      document.getElementById('pageTitle').textContent = t.pageTitle;
      document.getElementById('headerTitle').childNodes[0].nodeValue = t.headerTitle + ' ';
      document.getElementById('headerSubtitle').textContent = t.headerSubtitle;
      document.getElementById('galleryTitle').textContent = t.galleryTitle;
      document.getElementById('filterLabel').textContent = t.filterLabel;
      document.getElementById('catAll').textContent = t.catAll;
      document.getElementById('catPersonnages').textContent = t.catPersonnages;
      document.getElementById('catHistoire').textContent = t.catHistoire;
      document.getElementById('catFaireCarnaval').textContent = t.catFaireCarnaval;
      document.getElementById('catInfosPratiques').textContent = t.catInfosPratiques;
      document.getElementById('backBtnLabel').textContent = t.backBtn;
      document.getElementById('prevBtnLabel').textContent = t.prevBtn;
      document.getElementById('nextBtnLabel').textContent = t.nextBtn;
      document.getElementById('confettiBtnLabel').textContent = t.confettiLabel;
      document.getElementById('footerQuote').textContent = t.footerQuote;

      updateEdito();
      renderGallery();

      if (!document.getElementById('detailView').classList.contains('hidden')) {
        openArtwork(CARNAVAL_DATA[currentArtworkIndex].id, false);
      }
    }

    function renderGallery() {
      const grid = document.getElementById('drawingsGrid');
      grid.innerHTML = '';
      const t = UI_I18N[currentLang];

      const filtered = currentFilter === 'all'
        ? CARNAVAL_DATA
        : CARNAVAL_DATA.filter(item => (item.fr && item.fr.category && item.fr.category.trim().toLowerCase() === currentFilter.trim().toLowerCase()));

      if (filtered.length === 0) {
        grid.innerHTML = `
          <div class="col-span-full py-16 text-center text-moss-200">
            <span class="text-5xl block mb-3">🍃</span>
            <p class="font-title text-xl">${t.emptyFilter}</p>
          </div>
        `;
        return;
      }

      filtered.forEach((art, index) => {
        const itemData = art[currentLang];
        const tilt = window.innerWidth < 640 ? '0deg' : (art.tilt || '0deg');

        const card = document.createElement('div');
        card.className = 'leaning-drawing group cursor-pointer bg-[#FFFDF7] text-neutral-900 sketch-border p-4 shadow-wobble hover:shadow-wobble-hover flex flex-col justify-between rounded-3xl relative';
        card.style.transform = `rotate(${tilt})`;

        card.onclick = () => {
          launchForestConfetti();
          openArtwork(art.id);
        };

        let badgeColor = 'bg-mushroom-500';
        if (art.fr.category === 'Histoire') badgeColor = 'bg-festive-orange';
        if (art.fr.category === 'Faire Carnaval') badgeColor = 'bg-festive-teal';
        if (art.fr.category === 'Infos pratiques') badgeColor = 'bg-moss-700';
        console.log("itemData", itemData);

        card.innerHTML = `
          <div>
            <div class="relative w-full aspect-[4/3] rounded-2xl overflow-hidden bg-moss-100 border-2 border-bark-900 mb-3 shadow-inner">
              <img src="${art.image}" alt="${itemData.title}" loading="lazy" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105">
              <span class="absolute top-2.5 right-2.5 text-[11px] font-title font-extrabold px-3 py-1 rounded-full ${badgeColor} text-white shadow-md">
                ${itemData.category}
              </span>
              {% if itemData.cri and itemData.cri | trim %}
              <span class="absolute bottom-2 left-2 bg-bark-900/85 text-firefly text-[11px] px-2 py-0.5 rounded-lg font-hand font-bold">
                📢 ${itemData.cri}
              </span>
              {% endif %}
            </div>
            <div class="flex items-baseline justify-between gap-2">
              <h3 class="font-title text-lg sm:text-xl font-black text-bark-900 group-hover:text-mushroom-600 transition-colors">
                ${itemData.title}
              </h3>
              <div class="font-hand text-base text-right sm:text-lg text-moss-700 font-bold -mt-1 opacity-90">
                ${itemData.subtitle}
              </div>
            </div>
          </div>
          <div class="mt-4 pt-3 border-t-2 border-dashed border-moss-200 flex items-center justify-between text-xs font-title font-bold text-festive-orange">
            <span>${t.discoverBtn}</span>
            <span class="w-6 h-6 rounded-full bg-firefly text-bark-900 flex items-center justify-center group-hover:translate-x-1 transition-transform">
              <i class="fa-solid fa-arrow-right text-[10px]"></i>
            </span>
          </div>
        `;
        grid.appendChild(card);
      });
    }

    function filterCategory(cat, ev) {
      navigateHome();
      currentFilter = cat;
      document.querySelectorAll('.cat-pill').forEach(btn => {
        btn.classList.remove('active', 'bg-firefly', 'text-bark-900');
        btn.classList.add('bg-foliage/80', 'text-white');
      });
      if (ev && ev.currentTarget) {
        ev.currentTarget.classList.add('active', 'bg-firefly', 'text-bark-900');
        ev.currentTarget.classList.remove('bg-foliage/80', 'text-white');
      } else {
        const activeBtn = document.querySelector(`[onclick*="'${cat}'"]`) || document.getElementById('catAll');
        if (activeBtn) {
          activeBtn.classList.add('active', 'bg-firefly', 'text-bark-900');
          activeBtn.classList.remove('bg-foliage/80', 'text-white');
        }
      }
      renderGallery();
    }

    function openArtwork(id, doScroll = true) {
      const index = CARNAVAL_DATA.findIndex(a => a.id === id);
      if (index === -1) return;
      currentArtworkIndex = index;
      const art = CARNAVAL_DATA[index];
      const data = art[currentLang];
      const t = UI_I18N[currentLang];

      window.location.hash = `vignette/${art.id}`;

      document.getElementById('detailImage').src = art.image;
      document.getElementById('detailTitle').textContent = data.title;
      document.getElementById('detailBadge').textContent = data.category;
      document.getElementById('detailAccessoire').innerHTML = `<i class="fa-solid fa-hat-cowboy mr-1 text-festive-orange"></i> ${data.accessoire}`;
      document.getElementById('detailCri').innerHTML = `<i class="fa-solid fa-bullhorn mr-1 text-mushroom-500"></i> ${t.criPrefix} \"${data.cri}\"`;
      if (data.cri) {
        document.getElementById('detailCri').classList.remove('hidden');
      } else {
        document.getElementById('detailCri').classList.add('hidden');
      }
      if (data.accessoire) {
        document.getElementById('detailAccessoire').classList.remove('hidden');
      } else {
        document.getElementById('detailAccessoire').classList.add('hidden');
      }

      const detailMd = document.getElementById('detailMarkdown');
      if (currentLang === 'fr') {
        detailMd.innerHTML = data.description;
      } else {
        detailMd.innerHTML = window.marked ? marked.parse(data.description.trim()) : data.description;
      }

      document.getElementById('galleryView').classList.add('hidden');
      document.getElementById('detailView').classList.remove('hidden');

      if (doScroll) window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function navigateHome() {
      history.pushState("", document.title, window.location.pathname + window.location.search);
      document.getElementById('detailView').classList.add('hidden');
      document.getElementById('galleryView').classList.remove('hidden');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function navigateArtwork(dir) {
      currentArtworkIndex = (currentArtworkIndex + dir + CARNAVAL_DATA.length) % CARNAVAL_DATA.length;
      openArtwork(CARNAVAL_DATA[currentArtworkIndex].id);
    }

    function launchForestConfetti() {
      if (typeof confetti === 'function') {
        confetti({
          particleCount: 60,
          spread: 70,
          origin: { y: 0.65 },
          colors: ['#E63946', '#FFD152', '#20A39E', '#529E57', '#FF8A3D']
        });
      }
    }

    window.addEventListener('popstate', () => {
      const hash = window.location.hash;
      if (hash.startsWith('#vignette/')) {
        openArtwork(hash.replace('#vignette/', ''), false);
      } else {
        navigateHome();
      }
    });

    window.onload = function() {
      setLanguage('oc');
      if (window.location.hash.startsWith('#vignette/')) {
        openArtwork(window.location.hash.replace('#vignette/', ''));
      }
    };
  </script>
</body>
</html>
