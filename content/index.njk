      <button onclick="filterCategory('Histoire', event)" class="cat-pill px-3 py-1 rounded-full text-base font-bold whitespace-nowrap transition border border-white/20 bg-foliage/80 text-white hover:bg-moss-500" id="catHistoire">📜 Histoire</button>
      <button onclick="filterCategory('Faire Carnaval', event)" class="cat-pill px-3 py-1 rounded-full text-base font-bold whitespace-nowrap transition border border-white/20 bg-foliage/80 text-white hover:bg-moss-500" id="catFaireCarnaval">🎉 Faire Carnaval</button>
      <button onclick="filterCategory('Infos pratiques', event)" class="cat-pill px-3 py-1 rounded-full text-base font-bold whitespace-nowrap transition border border-white/20 bg-foliage/80 text-white hover:bg-moss-500" id="catInfosPratiques">ℹ️ Infos pratiques</button>
