            <circle cx="76" cy="43" r="2.8" fill="#E63946" />
            <circle cx="76" cy="57" r="2.8" fill="#E63946" />
            <circle cx="50" cy="82" r="3.2" fill="#E63946" />
            <circle cx="43" cy="76" r="2.8" fill="#E63946" />
            <circle cx="57" cy="76" r="2.8" fill="#E63946" />
            <circle cx="18" cy="50" r="3.2" fill="#E63946" />
            <circle cx="24" cy="43" r="2.8" fill="#E63946" />
